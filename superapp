  return ( <div> <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: 24 }}> <div className="page-title" style={{ marginBottom: 0 }}>Comedy</div> <button className="btn btn-primary" onClick={() => setShowAdd(true)}> New bit</button> </div> {showAdd && ( <div className="card" style={{ marginBottom: 24, borderColor: C.accent + "55" }}> <div style={{ fontSize: 15, fontWeight: 700, marginBottom: 16 }}>Write a new bit</div> <div style={{ display: "grid", gridTemplateColumns: "2fr 1fr", gap: 12, marginBottom: 10 }}> <input placeholder="Bit title / topic" value={form.title} onChange={e => setForm(f => ({ ...f, title: e.target.value }))} /> <select value={form.status} onChange={e => setForm(f => ({ ...f, status: e.target.value }))}> <option value="idea"> Idea</option> <option value="in progress"> In progress</option> <option value="stage ready"> Stage ready</option> <option value="retired"> Retired</option> </select> </div> <textarea placeholder="Setup…" value={form.setup} onChange={e => setForm(f => ({ ...f, setup: e.target.value }))} style={{ width: "100%", minHeight: 64, resize: "vertical", marginBottom: 10 }} /> <textarea placeholder="Punchline…" value={form.punchline} onChange={e => setForm(f => ({ ...f, punchline: e.target.value }))} style={{ width: "100%", minHeight: 48, resize: "vertical", marginBottom: 10 }} /> <textarea placeholder="Notes / alt punchlines / performance notes" value={form.notes} onChange={e => setForm(f => ({ ...f, notes: e.target.value }))} style={{ width: "100%", minHeight: 48, resize: "vertical", marginBottom: 10 }} /> <input placeholder="Tags (comma-separated: observational, dark, self-deprecating…)" value={form.tags} onChange={e => setForm(f => ({ ...f, tags: e.target.value }))} style={{ width: "100%", marginBottom: 12 }} /> <div style={{ display: "flex", gap: 8 }}> <button className="btn btn-primary" onClick={addBit}>Save bit</button> <button className="btn btn-ghost" onClick={() => setShowAdd(false)}>Cancel</button> </div> </div> )}

      {bits.length === 0 && !showAdd && ( <div style={{ textAlign: "center", padding: "80px 0", color: C.muted }}> <div style={{ fontSize: 48, marginBottom: 12 }}></div> <div style={{ fontSize: 16, fontWeight: 600, marginBottom: 6 }}>Your material lives here</div> <div style={{ fontSize: 13 }}>Start capturing bits, ideas, and setups</div> </div> )} <div style={{ display: "grid", gap: 14 }}> {bits.map(b => ( <div key={b.id} className="card" style={{ borderLeft: `3px solid ${statusColors[b.status] || C.muted}` }}> <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 10 }}> <div> <div style={{ fontSize: 15, fontWeight: 700, marginBottom: 4 }}>{b.title}</div> <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}> <span style={{ fontSize: 11, color: statusColors[b.status] || C.muted, fontWeight: 600, textTransform: "uppercase", letterSpacing: .5 }}> {b.status}</span> {(b.tags || []).map(tag => <span key={tag} className="tag tag-purple" style={{ fontSize: 10 }}>{tag}</span>)} </div> </div> <div style={{ display: "flex", gap: 8, alignItems: "center" }}> <span style={{ fontSize: 11, color: C.muted }}>{fmt(b.created)}</span> <button onClick={() => setBits(bs => bs.filter(x => x.id !== b.id))} style={{ background: "none", color: C.muted, fontSize: 16 }}>×</button> </div> </div> {b.setup && ( <div style={{ marginBottom: 8 }}> <div style={{ fontSize: 10, fontWeight: 700, color: C.muted, textTransform: "uppercase", letterSpacing: 1, marginBottom: 4 }}>Setup</div> <div style={{ fontSize: 13, color: C.text, lineHeight: 1.6, background: C.surfaceHigh, padding: "8px 12px", borderRadius: 8 }}>{b.setup}</div> </div> )}
            {b.punchline && ( <div style={{ marginBottom: 8 }}> <div style={{ fontSize: 10, fontWeight: 700, color: C.amber, textTransform: "uppercase", letterSpacing: 1, marginBottom: 4 }}>Punchline</div> <div style={{ fontSize: 13, color: C.text, lineHeight: 1.6, background: "#f59e0b11", border: `1px solid #f59e0b33`, padding: "8px 12px", borderRadius: 8 }}>{b.punchline}</div> </div> )}
            {b.notes && ( <div> <div style={{ fontSize: 10, fontWeight: 700, color: C.muted, textTransform: "uppercase", letterSpacing: 1, marginBottom: 4 }}>Notes</div> <div style={{ fontSize: 12, color: C.muted, lineHeight: 1.6 }}>{b.notes}</div> </div> )} </div> ))} </div> </div> );
}

