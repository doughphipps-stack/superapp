//  FITNESS 
function FitnessPage({ runs, setRuns, lifts, setLifts, weights, setWeights }) {
  const [tab, setTab] = useState("running");
  const [runForm, setRunForm] = useState({ date: today(), miles: "", duration: "", type: "easy" });
  const [liftForm, setLiftForm] = useState({ date: today(), exercise: "", sets: "", reps: "", weight: "", notes: "" });
  const [weightInput, setWeightInput] = useState("");
  const [weightRange, setWeightRange] = useState("week");

  // Running stats
  const avgByType = (type) => {
    const r = runs.filter(x => x.type === type);
    if (!r.length) return null;
    return { miles: (r.reduce((a,b) => a + +b.miles, 0) / r.length).toFixed(1), count: r.length };
  };

  function addRun() {
    if (!runForm.miles) return;
    const pace = runForm.duration && runForm.miles ? (parseFloat(runForm.duration) / parseFloat(runForm.miles)).toFixed(1) : null;
    setRuns(r => [...r, { ...runForm, id: Date.now(), pace }]);
    setRunForm(f => ({ ...f, miles: "", duration: "" }));
  }

  function addLift() {
    if (!liftForm.exercise) return;
    setLifts(l => [...l, { ...liftForm, id: Date.now() }]);
    setLiftForm(f => ({ ...f, exercise: "", sets: "", reps: "", weight: "", notes: "" }));
  }

  function logWeight() {
    if (!weightInput) return;
    setWeights(w => { const next = w.filter(x => x.date !== today()); return [...next, { date: today(), weight: +weightInput }]; });
    setWeightInput("");
  }

  // Weight chart
  const weightData = () => {
    const now = new Date();
    let days = 7;
    if (weightRange === "month") days = 30;
    if (weightRange === "year") days = 365;
    const cutoff = new Date(now - days * 86400000).toISOString().slice(0,10);
    return weights.filter(w => w.date >= cutoff).sort((a,b) => a.date.localeCompare(b.date));
  };

  const wData = weightData();
  const wMin = wData.length ? Math.min(...wData.map(x => x.weight)) - 2 : 150;
  const wMax = wData.length ? Math.max(...wData.map(x => x.weight)) + 2 : 200;

  // Group lifts by exercise
  const exerciseGroups = {};
  lifts.forEach(l => {
    if (!exerciseGroups[l.exercise]) exerciseGroups[l.exercise] = [];
    exerciseGroups[l.exercise].push(l);
  });

  return ( <div> <div style={{ display: "flex", alignItems: "center", gap: 0, marginBottom: 24, borderBottom: `1px solid ${C.border}`, paddingBottom: 0 }}> <div className="page-title" style={{ marginBottom: 16, marginRight: 32 }}>Fitness</div> {["running", "lifting", "weight"].map(t => ( <button key={t} onClick={() => setTab(t)} style={{ background: "none", border: "none", borderBottom: `2px solid ${tab===t?C.accent:"transparent"}`, color: tab===t?C.text:C.muted, padding: "10px 20px", fontSize: 14, fontWeight: tab===t?600:400, cursor: "pointer", marginBottom: -1 }}> {t === "running" ? " Running" : t === "lifting" ? " Lifting" : " Weight"} </button> ))} </div> {tab === "running" && ( <div> {/* Stat cards */} <div style={{ display: "grid", gridTemplateColumns: "repeat(3, 1fr)", gap: 14, marginBottom: 24 }}> {["easy","long","speed"].map(type => {
              const avg = avgByType(type);
              const emoji = type==="easy"?"":type==="long"?"":"";
              return ( <div key={type} className="card"> <div style={{ fontSize: 12, color: C.muted, marginBottom: 6 }}>{emoji} {type.charAt(0).toUpperCase()+type.slice(1)} runs</div> {avg ? <> <div style={{ fontSize: 26, fontWeight: 700 }}>{avg.miles} <span style={{ fontSize: 14, color: C.muted, fontWeight: 400 }}>avg mi</span></div> <div style={{ fontSize: 12, color: C.muted }}>{avg.count} logged</div> </> : <div style={{ color: C.muted, fontSize: 13 }}>No {type} runs yet</div>} </div> );
            })} </div> <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 20 }}> {/* Log run */} <div className="card"> <div style={{ fontSize: 14, fontWeight: 700, marginBottom: 14 }}>Log a run</div> <div style={{ display: "grid", gap: 10 }}> <input type="date" value={runForm.date} onChange={e => setRunForm(f => ({ ...f, date: e.target.value }))} /> <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10 }}> <input placeholder="Miles (e.g. 4.2)" type="number" step="0.1" value={runForm.miles} onChange={e => setRunForm(f => ({ ...f, miles: e.target.value }))} /> <input placeholder="Duration (min)" type="number" value={runForm.duration} onChange={e => setRunForm(f => ({ ...f, duration: e.target.value }))} /> </div> <select value={runForm.type} onChange={e => setRunForm(f => ({ ...f, type: e.target.value }))}> <option value="easy"> Easy run</option> <option value="long"> Long run</option> <option value="speed"> Speed run</option> </select> <button className="btn btn-primary" onClick={addRun}>Log run</button> </div> </div> {/* Recent runs */} <div className="card"> <div style={{ fontSize: 14, fontWeight: 700, marginBottom: 14 }}>Recent runs</div> <div style={{ maxHeight: 240, overflowY: "auto" }}> {[...runs].sort((a,b) => b.date.localeCompare(a.date)).slice(0,15).map(r => ( <div key={r.id} style={{ display: "flex", justifyContent: "space-between", alignItems: "center", padding: "8px 0", borderBottom: `1px solid ${C.border}` }}> <div> <span style={{ fontSize: 12, color: C.muted }}>{fmtShort(r.date)}</span> <span className="tag tag-purple" style={{ marginLeft: 8, fontSize: 10 }}>{r.type}</span> </div> <div style={{ textAlign: "right" }}> <div style={{ fontSize: 14, fontWeight: 600 }}>{r.miles} mi</div> {r.duration && <div style={{ fontSize: 11, color: C.muted }}>{r.duration} min{r.pace ? ` · ${r.pace} min/mi` : ""}</div>} </div> </div> ))}
                {!runs.length && <div style={{ color: C.muted, fontSize: 13, textAlign: "center", padding: 20 }}>No runs logged yet</div>} </div> </div> </div> <div className="card" style={{ marginTop: 20 }}> <div style={{ fontSize: 14, fontWeight: 700, marginBottom: 8 }}> Training plan advice</div> <p style={{ color: C.muted, fontSize: 13, lineHeight: 1.7 }}> <strong style={{ color: C.text }}>For recreational runners:</strong> The 80/20 rule — 80% easy, 20% hard — is backed by the most research. Aim for 3–4 runs/week: 2 easy runs, 1 long run (longest of the week, building ~10% weekly mileage), and 1 speed session (intervals or tempo). Easy runs should feel conversational. Consider a Garmin or Apple Watch to track heart rate zones automatically. </p> </div> </div> )}

      {tab === "lifting" && ( <div> <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 20, marginBottom: 20 }}> <div className="card"> <div style={{ fontSize: 14, fontWeight: 700, marginBottom: 14 }}>Log a set</div> <div style={{ display: "grid", gap: 10 }}> <input type="date" value={liftForm.date} onChange={e => setLiftForm(f => ({ ...f, date: e.target.value }))} /> <input placeholder="Exercise (e.g. Bench Press)" value={liftForm.exercise} onChange={e => setLiftForm(f => ({ ...f, exercise: e.target.value }))} /> <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 8 }}> <input placeholder="Sets" type="number" value={liftForm.sets} onChange={e => setLiftForm(f => ({ ...f, sets: e.target.value }))} /> <input placeholder="Reps" type="number" value={liftForm.reps} onChange={e => setLiftForm(f => ({ ...f, reps: e.target.value }))} /> <input placeholder="lbs" type="number" value={liftForm.weight} onChange={e => setLiftForm(f => ({ ...f, weight: e.target.value }))} /> </div> <input placeholder="Notes (optional)" value={liftForm.notes} onChange={e => setLiftForm(f => ({ ...f, notes: e.target.value }))} /> <button className="btn btn-primary" onClick={addLift}>Log set</button> </div> </div> <div className="card"> <div style={{ fontSize: 14, fontWeight: 700, marginBottom: 8 }}> Lifting framework</div> <p style={{ color: C.muted, fontSize: 13, lineHeight: 1.7 }}> For 3–4x/week, <strong style={{ color: C.text }}>Upper/Lower</strong> or <strong style={{ color: C.text }}>Push/Pull/Legs</strong> splits are most effective for tracking progressive overload. Log your sets, reps, and weight each session — when you can do all reps cleanly, add 5 lbs next session. Below, you'll see your max weight for each exercise over time. </p> </div> </div> {/* Progress per exercise */} <div style={{ fontSize: 14, fontWeight: 700, marginBottom: 14 }}>Progress by exercise</div> {Object.keys(exerciseGroups).length === 0 && ( <div className="card" style={{ textAlign: "center", padding: 40, color: C.muted }}>Log your first lift above to see progress here</div> )} <div style={{ display: "grid", gridTemplateColumns: "repeat(3, 1fr)", gap: 14 }}> {Object.entries(exerciseGroups).map(([ex, sets]) => {
              const recent = [...sets].sort((a,b) => b.date.localeCompare(a.date));
              const maxWeight = Math.max(...sets.map(s => +s.weight || 0));
              const firstMax = [...sets].sort((a,b) => a.date.localeCompare(b.date)).find(s => +s.weight === maxWeight);
              const latestMax = recent.find(s => +s.weight === maxWeight);
              return ( <div key={ex} className="card"> <div style={{ fontSize: 13, fontWeight: 700, marginBottom: 8 }}>{ex}</div> <div style={{ fontSize: 24, fontWeight: 700, color: C.accent }}>{maxWeight}<span style={{ fontSize: 12, color: C.muted, fontWeight: 400 }}> lbs PR</span></div> <div style={{ fontSize: 12, color: C.muted, marginTop: 4 }}>{sets.length} sets logged</div> <div style={{ fontSize: 11, color: C.muted, marginTop: 2 }}> Last: {recent[0].sets}×{recent[0].reps} @ {recent[0].weight}lbs ({fmtShort(recent[0].date)}) </div> </div> );
            })} </div> </div> )}

      {tab === "weight" && ( <div> <div style={{ display: "grid", gridTemplateColumns: "280px 1fr", gap: 20 }}> <div> <div className="card" style={{ marginBottom: 16 }}> <div style={{ fontSize: 14, fontWeight: 700, marginBottom: 14 }}>Log today's weight</div> <div style={{ display: "flex", gap: 8, marginBottom: 10 }}> <input placeholder="lbs" type="number" step="0.1" value={weightInput} onChange={e => setWeightInput(e.target.value)} style={{ flex: 1 }}
                    onKeyDown={e => e.key === "Enter" && logWeight()} /> <button className="btn btn-primary" onClick={logWeight}>Log</button> </div> {weights.find(w => w.date === today()) && ( <div style={{ fontSize: 12, color: C.green }}> Logged today: {weights.find(w => w.date === today()).weight} lbs</div> )} </div> {wData.length > 0 && ( <div className="card"> <div style={{ fontSize: 13, fontWeight: 700, marginBottom: 10 }}>Stats</div> <div style={{ display: "grid", gap: 8 }}> <div style={{ display: "flex", justifyContent: "space-between", fontSize: 13 }}> <span style={{ color: C.muted }}>Current</span> <span style={{ fontWeight: 600 }}>{wData[wData.length-1]?.weight} lbs</span> </div> <div style={{ display: "flex", justifyContent: "space-between", fontSize: 13 }}> <span style={{ color: C.muted }}>Period low</span> <span style={{ fontWeight: 600, color: C.green }}>{Math.min(...wData.map(x=>x.weight))} lbs</span> </div> <div style={{ display: "flex", justifyContent: "space-between", fontSize: 13 }}> <span style={{ color: C.muted }}>Period high</span> <span style={{ fontWeight: 600 }}>{Math.max(...wData.map(x=>x.weight))} lbs</span> </div> <div style={{ display: "flex", justifyContent: "space-between", fontSize: 13 }}> <span style={{ color: C.muted }}>Change</span> <span style={{ fontWeight: 600, color: wData[wData.length-1]?.weight < wData[0]?.weight ? C.green : C.red }}> {wData.length > 1 ? (wData[wData.length-1].weight - wData[0].weight).toFixed(1) : "—"} lbs </span> </div> </div> </div> )} </div> <div className="card"> <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 16 }}> <div style={{ fontSize: 14, fontWeight: 700 }}>Weight trend</div> <div style={{ display: "flex", gap: 6 }}> {["week","month","year"].map(r => ( <button key={r} onClick={() => setWeightRange(r)} className="btn" style={{ padding: "5px 12px", fontSize: 12, background: weightRange===r?C.accent:C.surfaceHigh, color: weightRange===r?"#fff":C.muted, border: `1px solid ${weightRange===r?C.accent:C.border}` }}> {r.charAt(0).toUpperCase()+r.slice(1)} </button> ))} </div> </div> {wData.length < 2 ? ( <div style={{ textAlign: "center", padding: "60px 0", color: C.muted, fontSize: 14 }}> Log at least 2 days to see your trend chart </div> ) : ( <svg viewBox={`0 0 600 200`} style={{ width: "100%", height: 200 }}> {/* Grid lines */}
                  {[0,1,2,3,4].map(i => ( <line key={i} x1={40} y1={10+i*40} x2={590} y2={10+i*40} stroke={C.border} strokeWidth={1} /> ))}
                  {/* Y labels */}
                  {[0,1,2,3,4].map(i => {
                    const w = wMax - (i/(4)) * (wMax - wMin);
                    return <text key={i} x={35} y={14+i*40} textAnchor="end" fill={C.muted} fontSize={10}>{Math.round(w)}</text> })}
                  {/* Line */}
                  {wData.map((pt, i) => {
                    const x = 50 + (i / Math.max(wData.length-1,1)) * 530;
                    const y = 10 + ((wMax - pt.weight) / (wMax - wMin)) * 160;
                    return i === 0 ? null : ( <line key={i}
                        x1={50 + ((i-1) / Math.max(wData.length-1,1)) * 530}
                        y1={10 + ((wMax - wData[i-1].weight) / (wMax - wMin)) * 160}
                        x2={x} y2={y} stroke={C.accent} strokeWidth={2} /> );
                  })}
                  {/* Dots */}
                  {wData.map((pt, i) => {
                    const x = 50 + (i / Math.max(wData.length-1,1)) * 530;
                    const y = 10 + ((wMax - pt.weight) / (wMax - wMin)) * 160;
                    return <circle key={i} cx={x} cy={y} r={4} fill={C.accent} />;
                  })} </svg> )} </div> </div> </div> )} </div> );
}

