-content" }}> <div style={{ fontSize: 14, fontWeight: 700, marginBottom: 16 }}>Daily targets</div> {macroBar("Calories", totals.calories, 2000, C.accent)}
          {macroBar("Carbs", totals.carbs, 250, "#f59e0b")}
          {macroBar("Protein", totals.protein, 150, C.green)}
          {macroBar("Fat", totals.fat, 65, "#ec4899")} <div style={{ fontSize: 11, color: C.muted, marginTop: 10, textAlign: "right" }}>Edit targets → settings (coming soon)</div> </div> </div> </div> );
